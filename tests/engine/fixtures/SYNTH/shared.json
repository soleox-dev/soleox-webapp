      "steps": [
        {
          "id": "TPR_001",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 1,
          "show_in_popup": false,
          "rule_name": "Referral",
          "rule_key": "referral",
          "section": "Off-the-top",
          "payee_entity_id": "ENT_00000000000B",
          "apply_condition": "referral_amount > 0",
          "calculation_formula": "referral_amount",
          "split_type": "AMOUNT"
        },
        {
          "id": "TPR_002",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 2,
          "show_in_popup": false,
          "rule_name": "TC Fee",
          "rule_key": "tc_fee",
          "section": "Pre-splits",
          "payee_entity_id": "ENT_00000000000C",
          "calculation_formula": "250",
          "split_type": "AMOUNT"
        },
        {
          "id": "TPR_003",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 3,
          "show_in_popup": false,
          "rule_name": "Agent 1 Split",
          "rule_key": "a1_split",
          "section": "Agent Splits",
          "agent_key": "agent_1",
          "calculation_formula": "baseline * a1_split_percent",
          "split_type": "PERCENT"
        },
        {
          "id": "TPR_004",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 4,
          "show_in_popup": false,
          "rule_name": "Agent 2 Split",
          "rule_key": "a2_split",
          "section": "Agent Splits",
          "agent_key": "agent_2",
          "apply_condition": "agent_2 <> \"\"",
          "calculation_formula": "baseline * a2_split_percent",
          "split_type": "PERCENT"
        },
        {
          "id": "TPR_005",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 5,
          "show_in_popup": false,
          "rule_name": "Team Lead Split",
          "rule_key": "tl_split",
          "section": "Agent Splits",
          "agent_key": "team_lead",
          "apply_condition": "team_lead <> \"\"",
          "calculation_formula": "IFERROR(team_cap.total, 0)",
          "split_type": "AMOUNT"
        },
        {
          "id": "TPR_006",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 6,
          "show_in_popup": false,
          "rule_name": "A1 Company Comm",
          "rule_key": "a1_company",
          "section": "Level 1 Post-splits",
          "agent_key": "agent_1",
          "payee_entity_id": "ENT_00000000000A",
          "calculation_formula": "MIN(baseline * 20%, MAX(0, 5000 - SUMIFS(transaction_commission_items.final_amount, transaction_commission_items.agent_id, agent_1, commission_entities.entity_name, \"Company Comm\", transactions.closing_date, \">=\" & a1_cap_reset, transactions.closing_date, \"<\" & closing_date, transactions.transaction_status, \"Closed\")))",
          "split_type": "PERCENT"
        },
        {
          "id": "TPR_007",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 7,
          "show_in_popup": false,
          "rule_name": "A2 Company Comm",
          "rule_key": "a2_company",
          "section": "Level 1 Post-splits",
          "agent_key": "agent_2",
          "payee_entity_id": "ENT_00000000000A",
          "apply_condition": "agent_2 <> \"\"",
          "calculation_formula": "baseline * 20%",
          "split_type": "PERCENT"
        },
        {
          "id": "TPR_008",
          "template_id": "TPL_SYNTH0000001",
          "step_number": 8,
          "show_in_popup": false,
          "rule_name": "A1 Stock",
          "rule_key": "a1_stock",
          "section": "Level 2 Post-splits",
          "agent_key": "agent_1",
          "payee_entity_id": "ENT_00000000000D",
          "apply_condition": "stock_option = \"Yes\"",
          "calculation_formula": "baseline * 5%",
          "split_type": "PERCENT"
        }
      ]
    }
  },
